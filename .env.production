# Production env for the Vite web app (apps/web). Vite auto-loads this file
# for `vite build`. All values are public on-chain data — Celo Mainnet
# contract addresses and chain id — so committing them is correct.
# Source of truth: apps/api/wrangler.toml [vars].

# Celo Mainnet
VITE_CHAIN_ID=42220

# Score registries (one per game)
VITE_SCORE_REGISTRY_ADDRESS_GAS_GOBBLER=0xF26Ed81D52ae4A106344f5739D767e3D603f8370
VITE_SCORE_REGISTRY_ADDRESS_BLOCK_BREAKER=0xE27010F31B09F9666861098faC5cCB459DaD608D
VITE_SCORE_REGISTRY_ADDRESS_STABLE_SPRINT=0x51128D31536c712c9d29Cc1B139d415081971126
VITE_SCORE_REGISTRY_ADDRESS_MENTO_INVADERS=0x7aa5139F4c94297d4b58EC8C722E43CE0D3840a6

# Leaderboard aggregator
VITE_LEADERBOARD_ADDRESS=0x2f8768b0444673Bb61C57DE1DC9f81411E195353

# Game-API Worker (web app default already matches this; can override here)
# VITE_API_URL=https://celo-atari-games-api.cryptoflops-00.workers.dev
